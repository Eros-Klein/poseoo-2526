<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SatisfactoryPlanner.UI.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="SatisfactoryPlanner.UI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="SatisfactoryPlanner.UI">

    <TabControl>
        <TabItem Header="Machines">
            <ContentControl Content="{Binding MachineListViewModel}"/>
        </TabItem>
        <TabItem Header="Recipes">
            <ContentControl />
        </TabItem>
        <TabItem Header="Drawer">
            <ContentControl />
        </TabItem>
    </TabControl>
</Window>
