{
  "openapi": "3.0.1",
  "info": {
    "title": "WebApi | v1",
    "version": "1.0.0"
  },
  "paths": {
    "/employees": {
      "get": {
        "tags": [
          "TimeTrackingEndpoints"
        ],
        "description": "Returns all persisted Employees",
        "operationId": "Get all Employees",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Employee"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/projects": {
      "get": {
        "tags": [
          "TimeTrackingEndpoints"
        ],
        "description": "Returns all persisted Projects",
        "operationId": "Get all Projects",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Project"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/timeentries": {
      "get": {
        "tags": [
          "TimeTrackingEndpoints"
        ],
        "description": "Returns filtered persisted Timeentries",
        "operationId": "Get Timeentries by optional filters: employeeId, projectId",
        "parameters": [
          {
            "name": "employeeId",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "projectId",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/TimeEntry"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/timeentries/{id}": {
      "get": {
        "tags": [
          "TimeTrackingEndpoints"
        ],
        "description": "Returns the found Timeentry or 404",
        "operationId": "Get Timeentry by id",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TimeEntry"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "TimeTrackingEndpoints"
        ],
        "description": "Does what the name says",
        "operationId": "Delete Timeentry by id",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NoContentResult"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "TimeTrackingEndpoints"
        ],
        "description": "Everything except the Id can be updated",
        "operationId": "Update Timeentry by id",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TimeEntryUpdateReq"
              }
            }
          },
          "required": true
        },
        "responses": {
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NoContentResult"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Employee": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "emplyeeId": {
            "maxLength": 5,
            "type": "string"
          },
          "employeeName": {
            "maxLength": 100,
            "type": "string"
          }
        }
      },
      "Employee2": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "emplyeeId": {
            "maxLength": 5,
            "type": "string"
          },
          "employeeName": {
            "maxLength": 100,
            "type": "string"
          }
        },
        "nullable": true
      },
      "EmployeeDto": {
        "required": [
          "employeeId",
          "employeeName"
        ],
        "type": "object",
        "properties": {
          "employeeId": {
            "type": "string"
          },
          "employeeName": {
            "type": "string"
          }
        }
      },
      "NoContentResult": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "Project": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "projectCode": {
            "maxLength": 20,
            "type": "string"
          }
        }
      },
      "Project2": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "projectCode": {
            "maxLength": 20,
            "type": "string"
          }
        },
        "nullable": true
      },
      "ProjectDto": {
        "required": [
          "projectCode"
        ],
        "type": "object",
        "properties": {
          "projectCode": {
            "type": "string"
          }
        }
      },
      "TimeEntry": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "startTime": {
            "type": "string",
            "format": "time"
          },
          "endTime": {
            "type": "string",
            "format": "time"
          },
          "description": {
            "maxLength": 200,
            "type": "string"
          },
          "employeeId": {
            "type": "integer",
            "format": "int32"
          },
          "employee": {
            "$ref": "#/components/schemas/Employee2"
          },
          "projectId": {
            "type": "integer",
            "format": "int32"
          },
          "project": {
            "$ref": "#/components/schemas/Project2"
          }
        }
      },
      "TimeEntryUpdateReq": {
        "required": [
          "date",
          "startTime",
          "endTime",
          "description",
          "employee",
          "project"
        ],
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "startTime": {
            "type": "string",
            "format": "time"
          },
          "endTime": {
            "type": "string",
            "format": "time"
          },
          "description": {
            "type": "string"
          },
          "employee": {
            "$ref": "#/components/schemas/EmployeeDto"
          },
          "project": {
            "$ref": "#/components/schemas/ProjectDto"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "TimeTrackingEndpoints"
    }
  ]
}