<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SatisfactoryPlanner.UI.ViewModels"
             xmlns:m="clr-namespace:SatisfactoryPlanner.Data;assembly=SatisfactoryPlanner.Data"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="vm:MachineListViewModel"
             x:Class="SatisfactoryPlanner.UI.Views.MachineListView">
    <DataGrid
        ItemsSource="{Binding Machines}"
        AutoGenerateColumns="False"
        CanUserReorderColumns="False"
        CanUserResizeColumns="False"
        CanUserSortColumns="False"
        IsReadOnly="True"
        GridLinesVisibility="All"
        HeadersVisibility="Column">
        
        <DataGrid.Columns>
            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="200" />
            <DataGridTextColumn Header="Recipe Type" Binding="{Binding RecipeType}" Width="120" />
            <DataGridTextColumn Header="Level" Binding="{Binding RecipeLevel}" Width="80" />
            <DataGridTemplateColumn Header="Recipe Output" Width="200">
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate DataType="m:Machine">
                        <TextBlock Text="{Binding Recipe.ResultingElement.Name}" 
                                   VerticalAlignment="Center"
                                   Margin="5,0"/>
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="Materials" Width="*">
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate DataType="m:Machine">
                        <ItemsControl ItemsSource="{Binding Recipe.ElementLines}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="m:ElementLine">
                                    <StackPanel Orientation="Horizontal" Margin="2">
                                        <TextBlock Text="{Binding Quantity}" 
                                                   FontWeight="Bold"
                                                   Margin="0,0,5,0"/>
                                        <TextBlock Text="x" Margin="0,0,5,0"/>
                                        <TextBlock Text="{Binding Element.Name}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
        </DataGrid.Columns>
    </DataGrid>
</UserControl>
